<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Aether</RootNamespace>
    <AssemblyName>Aether</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- the Aether mark, as on macOS, GNOME and the web; regenerate with make-icon.ps1 -->
    <ApplicationIcon>Aether.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- run on .NET 8 or anything newer that is installed -->
    <RollForward>Major</RollForward>
    <Version>1.0.0</Version>
    <Product>Aether</Product>
    <Description>Aether animated wallpaper host</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <!-- the shared page ships next to the exe, so a published copy works on its own -->
  <ItemGroup Condition="'$(PublishSingleFile)' != 'true'">
    <Content Include="..\web\wallpaper.html;..\web\aether.html;..\web\aether-bg.js" Link="web\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- ...and inside the exe too, for the single-file build (build-exe.ps1), which unpacks it on start -->
  <ItemGroup>
    <EmbeddedResource Include="..\web\wallpaper.html;..\web\aether.html;..\web\aether-bg.js" LogicalName="web/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- the single-file build installs itself when run from anywhere else (src/Installer.cs) -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <DefineConstants>$(DefineConstants);BUNDLE</DefineConstants>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- the WebView2 package also references its WPF control, which a WinForms app doesn't need -->
  <Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
